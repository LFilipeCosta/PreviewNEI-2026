}

/*FIX MENU WIDTH*/
jQuery(window).resize(function () {

    $(".menu").attr("style", "margin-left:" + ($(".logo").width() + 20) + "px;" + "margin-right:" + ($(window).width() - $(".tools.group").position().left - $(".tools.group").width() - 20) + "px;");
});

